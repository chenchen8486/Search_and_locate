<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <OpenCVRoot Condition="'$(OpenCVRoot)' == '' and '$(OPENCV_DIR)' != ''">$(OPENCV_DIR)</OpenCVRoot>
    <OpenCVRoot Condition="'$(OpenCVRoot)' == ''">C:\opencv\build</OpenCVRoot>
    <OpenCVToolset Condition="'$(OpenCVToolset)' == ''">vc16</OpenCVToolset>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(OpenCVRoot)\include;$(IncludePath)</IncludePath>
    <LibraryPath>$(OpenCVRoot)\x64\$(OpenCVToolset)\lib;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
</Project>
