#include "resource.h"
#include <afxres.h>

IDD_LOCATOR_MFC DIALOGEX 0, 0, 1000, 485
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "搜索匹配定位工具"
FONT 8, "Microsoft YaHei UI"
BEGIN
    LTEXT "搜索匹配定位", IDC_APP_TITLE, 18, 10, 500, 22
    LTEXT "图像定位、参数试验与批量性能评估", IDC_APP_SUBTITLE, 18, 36, 650, 16

    LTEXT "", IDC_PANEL_WORKSPACE, 14, 56, 680, 248
    LTEXT "", IDC_PANEL_PARAMETERS, 706, 56, 280, 252
    LTEXT "", IDC_PANEL_RESULTS, 14, 314, 680, 157
    LTEXT "", IDC_PANEL_BATCH, 706, 318, 280, 153

    LTEXT "图像工作区", IDC_SECTION_WORKSPACE, 28, 64, 120, 16
    LTEXT "加载图像，或直接在大图上框选模板和搜索范围", IDC_WORKSPACE_HINT, 190, 66, 490, 14
    PUSHBUTTON "加载搜索图", IDC_LOAD_SEARCH, 28, 82, 100, 20, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "加载模板", IDC_LOAD_TEMPLATE, 136, 82, 90, 20, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "框选模板", IDC_SELECT_TEMPLATE, 234, 82, 104, 20, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "设置搜索 ROI", IDC_SELECT_ROI, 346, 82, 100, 20, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "清除 ROI", IDC_CLEAR_ROI, 454, 82, 86, 20, BS_OWNERDRAW | WS_TABSTOP
    CONTROL "", IDC_SEARCH_VIEW, "Static", SS_NOTIFY, 28, 110, 456, 134
    LTEXT "模板预览", IDC_TEMPLATE_LABEL, 496, 110, 184, 12
    CONTROL "", IDC_TEMPLATE_VIEW, "Static", SS_NOTIFY, 496, 126, 184, 106
    LTEXT "", IDC_SEARCH_PATH, 28, 248, 456, 22, SS_PATHELLIPSIS
    LTEXT "", IDC_TEMPLATE_PATH, 496, 236, 184, 34
    LTEXT "", IDC_STATUS_TEXT, 28, 279, 652, 18

    LTEXT "匹配结果", IDC_SECTION_RESULTS, 28, 322, 100, 16
    LTEXT "单次搜索显示全部结果，批量评估仅显示失败任务", IDC_RESULT_HINT, 170, 324, 510, 14
    CONTROL "", IDC_RESULT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 28, 346, 652, 111

    LTEXT "搜索参数", IDC_SECTION_PARAMETERS, 718, 64, 120, 16
    LTEXT "计算后端", -1, 718, 83, 64, 14
    COMBOBOX IDC_BACKEND, 786, 79, 186, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    LTEXT "角度（度）", IDC_SECTION_ANGLE, 718, 102, 100, 13
    LTEXT "最小值", -1, 718, 116, 76, 12
    LTEXT "最大值", -1, 806, 116, 76, 12
    LTEXT "步进", -1, 894, 116, 76, 12
    EDITTEXT IDC_ANGLE_MIN, 718, 129, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_MAX, 806, 129, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_STEP, 894, 129, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT "尺度", IDC_SECTION_SCALE, 718, 151, 100, 13
    LTEXT "最小值", -1, 718, 165, 76, 12
    LTEXT "最大值", -1, 806, 165, 76, 12
    LTEXT "步进", -1, 894, 165, 76, 12
    EDITTEXT IDC_SCALE_MIN, 718, 178, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_MAX, 806, 178, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_STEP, 894, 178, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT "精度与结果", IDC_SECTION_RESULT_OPTIONS, 718, 200, 120, 13
    LTEXT "金字塔层数", -1, 718, 214, 76, 12
    LTEXT "亚像素档位", -1, 806, 214, 76, 12
    LTEXT "最低分数", -1, 894, 214, 76, 12
    EDITTEXT IDC_PYRAMID, 718, 227, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SUBPIXEL, 806, 227, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_MIN_SCORE, 894, 227, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Top-N", -1, 718, 249, 76, 12
    LTEXT "x 邻近半径", -1, 806, 249, 76, 12
    LTEXT "y 邻近半径", -1, 894, 249, 76, 12
    EDITTEXT IDC_MAX_RESULTS, 718, 262, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_X_VICINITY, 806, 262, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_Y_VICINITY, 894, 262, 76, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "执行搜索", IDC_EXECUTE, 718, 285, 254, 18, BS_OWNERDRAW | WS_TABSTOP

    LTEXT "批量评估", IDC_SECTION_BATCH, 718, 326, 120, 16
    LTEXT "目录", -1, 718, 350, 34, 14
    EDITTEXT IDC_BATCH_PATH, 754, 346, 150, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择", IDC_BATCH_BROWSE, 910, 346, 62, 18, BS_OWNERDRAW | WS_TABSTOP
    LTEXT "任务数（0 = 全部）", -1, 718, 372, 120, 12
    LTEXT "线程数", -1, 852, 372, 120, 12
    EDITTEXT IDC_BATCH_COUNT, 718, 385, 120, 18, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_BATCH_THREADS, 852, 385, 120, 18, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "运行批量评估", IDC_BATCH_RUN, 718, 410, 254, 20, BS_OWNERDRAW | WS_TABSTOP
    LTEXT "", IDC_BATCH_STATS, 718, 436, 254, 28
END
