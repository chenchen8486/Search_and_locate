#include "resource.h"
#include <afxres.h>

IDD_LOCATOR_MFC DIALOGEX 0, 0, 1120, 735
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "搜索匹配定位演示与评估"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON "加载搜索图", IDC_LOAD_SEARCH, 10, 12, 105, 24
    PUSHBUTTON "加载模板", IDC_LOAD_TEMPLATE, 125, 12, 100, 24
    PUSHBUTTON "从大图框选模板", IDC_SELECT_TEMPLATE, 235, 12, 130, 24
    PUSHBUTTON "设置搜索 ROI", IDC_SELECT_ROI, 375, 12, 110, 24
    PUSHBUTTON "清除 ROI", IDC_CLEAR_ROI, 495, 12, 90, 24

    CONTROL "", IDC_SEARCH_VIEW, "Static", SS_BLACKFRAME | SS_NOTIFY, 10, 45, 560, 390
    CONTROL "", IDC_TEMPLATE_VIEW, "Static", SS_BLACKFRAME, 580, 45, 200, 170
    LTEXT "", IDC_SEARCH_PATH, 10, 438, 560, 16, SS_PATHELLIPSIS
    LTEXT "", IDC_TEMPLATE_PATH, 580, 220, 200, 34
    LTEXT "", IDC_STATUS_TEXT, 10, 462, 770, 30
    CONTROL "", IDC_RESULT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 10, 500, 770, 220

    GROUPBOX "搜索参数", -1, 790, 45, 320, 435
    LTEXT "计算后端", -1, 805, 57, 110, 16
    COMBOBOX IDC_BACKEND, 925, 54, 90, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "最小角度（度）", -1, 805, 85, 110, 16
    EDITTEXT IDC_ANGLE_MIN, 925, 82, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "最大角度（度）", -1, 805, 113, 110, 16
    EDITTEXT IDC_ANGLE_MAX, 925, 110, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "角度步进", -1, 805, 141, 110, 16
    EDITTEXT IDC_ANGLE_STEP, 925, 138, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "最小尺度", -1, 805, 169, 110, 16
    EDITTEXT IDC_SCALE_MIN, 925, 166, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "最大尺度", -1, 805, 197, 110, 16
    EDITTEXT IDC_SCALE_MAX, 925, 194, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "尺度步进", -1, 805, 225, 110, 16
    EDITTEXT IDC_SCALE_STEP, 925, 222, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "金字塔层数", -1, 805, 253, 110, 16
    EDITTEXT IDC_PYRAMID, 925, 250, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "亚像素档位", -1, 805, 281, 110, 16
    EDITTEXT IDC_SUBPIXEL, 925, 278, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "最低分数（0～100）", -1, 805, 309, 115, 16
    EDITTEXT IDC_MIN_SCORE, 925, 306, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Top-N", -1, 805, 337, 110, 16
    EDITTEXT IDC_MAX_RESULTS, 925, 334, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "x 邻近半径", -1, 805, 365, 110, 16
    EDITTEXT IDC_X_VICINITY, 925, 362, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "y 邻近半径", -1, 805, 393, 110, 16
    EDITTEXT IDC_Y_VICINITY, 925, 390, 90, 20, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "执行搜索", IDC_EXECUTE, 805, 435, 290, 30

    GROUPBOX "批量评估", -1, 790, 485, 320, 235
    LTEXT "数据目录", -1, 805, 510, 60, 16
    EDITTEXT IDC_BATCH_PATH, 870, 507, 165, 20, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择", IDC_BATCH_BROWSE, 1040, 507, 55, 20
    LTEXT "任务数（0=全部）", -1, 805, 540, 115, 16
    EDITTEXT IDC_BATCH_COUNT, 925, 537, 55, 20, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "线程数", -1, 995, 540, 50, 16
    EDITTEXT IDC_BATCH_THREADS, 1045, 537, 50, 20, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "运行批量评估", IDC_BATCH_RUN, 805, 568, 290, 26
    LTEXT "", IDC_BATCH_STATS, 805, 605, 285, 95
END
