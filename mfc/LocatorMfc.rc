#include "resource.h"
#include <afxres.h>

IDD_LOCATOR_MFC DIALOGEX 0, 0, 780, 410
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "搜索匹配定位工具"
FONT 8, "Microsoft YaHei UI"
BEGIN
    LTEXT "搜索匹配定位", IDC_APP_TITLE, 16, 10, 150, 24
    LTEXT "8 位灰度模板匹配与参数评估", IDC_APP_SUBTITLE, 180, 16, 420, 16
    LTEXT "计算后端", IDC_BACKEND_LABEL, 610, 14, 60, 18
    COMBOBOX IDC_BACKEND, 674, 12, 90, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    LTEXT "", IDC_PANEL_WORKSPACE, 16, 56, 536, 224
    LTEXT "", IDC_PANEL_PARAMETERS, 564, 56, 200, 340
    LTEXT "", IDC_PANEL_RESULTS, 16, 292, 536, 104

    PUSHBUTTON "加载搜索图", IDC_LOAD_SEARCH, 28, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "加载模板", IDC_LOAD_TEMPLATE, 130, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "设置 ROI", IDC_SELECT_ROI, 334, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "清除 ROI", IDC_CLEAR_ROI, 436, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "复位（初始状态）", IDC_RESET, 436, 98, 94, 28, BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED
    LTEXT "搜索图", IDC_SEARCH_TITLE, 28, 106, 70, 18
    LTEXT "", IDC_IMAGE_META_SEARCH, 104, 108, 260, 16
    CONTROL "", IDC_SEARCH_VIEW, "Static", SS_NOTIFY, 28, 130, 334, 116
    LTEXT "", IDC_SEARCH_PATH, 28, 252, 334, 18, SS_PATHELLIPSIS
    CONTROL "", IDC_DIVIDER_IMAGES, "Static", SS_ETCHEDVERT, 376, 106, 2, 164
    LTEXT "模板", IDC_TEMPLATE_TITLE, 390, 106, 60, 18
    LTEXT "", IDC_IMAGE_META_TEMPLATE, 456, 108, 80, 16
    CONTROL "", IDC_TEMPLATE_VIEW, "Static", SS_NOTIFY, 390, 130, 146, 116
    LTEXT "", IDC_TEMPLATE_PATH, 390, 252, 146, 18, SS_PATHELLIPSIS

    LTEXT "定位结果", IDC_RESULTS_TITLE, 28, 302, 100, 18
    LTEXT "x、y 为模板几何中心", IDC_RESULT_HINT, 144, 304, 392, 16
    CONTROL "", IDC_RESULT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 28, 370, 512, 54

    CONTROL "", IDC_MODE_TABS, "SysTabControl32", TCS_FIXEDWIDTH | TCS_MULTILINE | TCS_OWNERDRAWFIXED | TCS_FOCUSONBUTTONDOWN | WS_TABSTOP, 564, 56, 200, 40
    LTEXT "坐标原点在左上，正角度顺时针。", IDC_PARAMETER_HINT, 576, 108, 176, 16
    CONTROL "角度范围", IDC_ANGLE_TITLE, "Button", BS_GROUPBOX, 568, 128, 192, 132
    LTEXT "单位为度，正数顺时针", IDC_ANGLE_HINT, 588, 154, 168, 16
    LTEXT "最小角度", IDC_ANGLE_MIN_LABEL, 588, 180, 52, 16
    LTEXT "最大角度", IDC_ANGLE_MAX_LABEL, 648, 180, 52, 16
    LTEXT "角度步进", IDC_ANGLE_STEP_LABEL, 708, 180, 52, 16
    EDITTEXT IDC_ANGLE_MIN, 588, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_MAX, 648, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_STEP, 708, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP

    CONTROL "尺度范围", IDC_SCALE_TITLE, "Button", BS_GROUPBOX, 568, 262, 192, 130
    LTEXT "模板缩放倍率，1.0 为原始尺寸", IDC_SCALE_HINT, 588, 288, 168, 16
    LTEXT "最小倍率", IDC_SCALE_MIN_LABEL, 588, 314, 52, 16
    LTEXT "最大倍率", IDC_SCALE_MAX_LABEL, 648, 314, 52, 16
    LTEXT "倍率步进", IDC_SCALE_STEP_LABEL, 708, 314, 52, 16
    EDITTEXT IDC_SCALE_MIN, 588, 332, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_MAX, 648, 332, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_STEP, 708, 332, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP

    CONTROL "精度与结果", IDC_RESULT_OPTIONS_TITLE, "Button", BS_GROUPBOX, 568, 396, 192, 182
    LTEXT "亚像素：1/2/4/8 档。去重：中心半径（像素）", IDC_PRECISION_HINT, 588, 420, 168, 16
    LTEXT "金字塔层数", IDC_PYRAMID_LABEL, 588, 448, 52, 16
    LTEXT "亚像素（档）", IDC_SUBPIXEL_LABEL, 648, 448, 52, 16
    LTEXT "最低分（%）", IDC_MIN_SCORE_LABEL, 708, 448, 52, 16
    EDITTEXT IDC_PYRAMID, 588, 466, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_SUBPIXEL, 648, 466, 52, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    EDITTEXT IDC_MIN_SCORE, 708, 466, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "结果数（Top-N）", IDC_MAX_RESULTS_LABEL, 588, 508, 52, 16
    LTEXT "x 去重（px）", IDC_X_VICINITY_LABEL, 648, 508, 52, 16
    LTEXT "y 去重（px）", IDC_Y_VICINITY_LABEL, 708, 508, 52, 16
    EDITTEXT IDC_MAX_RESULTS, 588, 526, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_X_VICINITY, 648, 526, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_Y_VICINITY, 708, 526, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "角度 0°，尺度 1（原始尺寸）\n搜索范围：完整图像", IDC_EXECUTION_HINT, 576, 600, 176, 32
    DEFPUSHBUTTON "执行搜索", IDC_EXECUTE, 576, 638, 176, 30, BS_OWNERDRAW | WS_TABSTOP

    CONTROL "数据目录", IDC_BATCH_DIRECTORY_TITLE, "Button", BS_GROUPBOX, 568, 102, 192, 104
    LTEXT "目录路径（含 Thick 搜索图与模板）", IDC_BATCH_DIRECTORY_LABEL, 588, 134, 168, 16
    EDITTEXT IDC_BATCH_PATH, 588, 160, 108, 24, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择目录", IDC_BATCH_BROWSE, 700, 160, 52, 24, BS_OWNERDRAW | WS_TABSTOP
    CONTROL "执行设置", IDC_BATCH_SETTINGS_TITLE, "Button", BS_GROUPBOX, 568, 220, 192, 230
    LTEXT "目录待扫描；任务数 0 表示全部", IDC_BATCH_SETTINGS_HINT, 588, 248, 168, 16
    LTEXT "任务数（0 = 全部）", IDC_BATCH_COUNT_LABEL, 588, 282, 82, 16
    LTEXT "线程数（并行数）", IDC_BATCH_THREADS_LABEL, 674, 282, 82, 16
    EDITTEXT IDC_BATCH_COUNT, 588, 300, 82, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_BATCH_THREADS, 674, 300, 82, 24, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "后端=CPU | 金字塔=1 | 亚像素=1/8 | 最低分=0\n角度=0 | 尺度=1\nTop-N=1 | 去重=(0,0)px | 完整图像", IDC_BATCH_CONFIG_HINT, 588, 342, 168, 52
    DEFPUSHBUTTON "运行批量评估", IDC_BATCH_RUN, 588, 404, 82, 30, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "取消（任务边界停止）", IDC_BATCH_CANCEL, 674, 404, 82, 30, BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED
    CONTROL "统计结果", IDC_BATCH_STATS_TITLE, "Button", BS_GROUPBOX, 568, 458, 192, 216
    LTEXT "尚未执行", IDC_BATCH_PROGRESS, 588, 482, 88, 16
    COMBOBOX IDC_BATCH_FILTER, 684, 480, 68, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL "", IDC_BATCH_STATS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_TABSTOP, 588, 510, 164, 152

    LTEXT "", IDC_STATUS_TEXT, 16, 394, 748, 20
END
