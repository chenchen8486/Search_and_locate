#include "resource.h"
#include <afxres.h>

IDD_LOCATOR_MFC DIALOGEX 0, 0, 780, 410
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "搜索匹配定位工具"
FONT 8, "Microsoft YaHei UI"
BEGIN
    LTEXT "搜索匹配定位", IDC_APP_TITLE, 16, 10, 150, 24
    LTEXT "8 位灰度模板匹配与参数评估", IDC_APP_SUBTITLE, 180, 16, 420, 16
    LTEXT "计算后端", IDC_BACKEND_LABEL, 610, 14, 60, 18
    COMBOBOX IDC_BACKEND, 674, 12, 90, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    LTEXT "", IDC_PANEL_WORKSPACE, 16, 56, 536, 224
    LTEXT "", IDC_PANEL_PARAMETERS, 564, 56, 200, 340
    LTEXT "", IDC_PANEL_RESULTS, 16, 292, 536, 104

    PUSHBUTTON "加载搜索图", IDC_LOAD_SEARCH, 28, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "加载模板", IDC_LOAD_TEMPLATE, 130, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "设置 ROI", IDC_SELECT_ROI, 334, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "清除 ROI", IDC_CLEAR_ROI, 436, 66, 94, 28, BS_OWNERDRAW | WS_TABSTOP
    LTEXT "搜索图", IDC_SEARCH_TITLE, 28, 106, 70, 18
    LTEXT "", IDC_IMAGE_META_SEARCH, 104, 108, 260, 16
    CONTROL "", IDC_SEARCH_VIEW, "Static", SS_NOTIFY, 28, 130, 334, 116
    LTEXT "", IDC_SEARCH_PATH, 28, 252, 334, 18, SS_PATHELLIPSIS
    CONTROL "", IDC_DIVIDER_IMAGES, "Static", SS_ETCHEDVERT, 376, 106, 2, 164
    LTEXT "模板", IDC_TEMPLATE_TITLE, 390, 106, 60, 18
    LTEXT "", IDC_IMAGE_META_TEMPLATE, 456, 108, 80, 16
    CONTROL "", IDC_TEMPLATE_VIEW, "Static", SS_NOTIFY, 390, 130, 146, 116
    LTEXT "", IDC_TEMPLATE_PATH, 390, 252, 146, 18, SS_PATHELLIPSIS

    LTEXT "定位结果", IDC_RESULTS_TITLE, 28, 302, 100, 18
    LTEXT "x、y 为模板几何中心", IDC_RESULT_HINT, 144, 304, 392, 16
    CONTROL "", IDC_RESULT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 28, 330, 512, 54

    CONTROL "", IDC_MODE_TABS, "SysTabControl32", TCS_FIXEDWIDTH | TCS_MULTILINE | TCS_FOCUSONBUTTONDOWN | WS_TABSTOP, 564, 56, 200, 40
    LTEXT "坐标原点在左上，正角度顺时针。", IDC_PARAMETER_HINT, 576, 108, 176, 16
    LTEXT "角度范围", IDC_ANGLE_TITLE, 576, 136, 176, 18
    LTEXT "单位为度，正数顺时针", IDC_ANGLE_HINT, 576, 156, 176, 16
    LTEXT "最小角度", IDC_ANGLE_MIN_LABEL, 576, 180, 52, 16
    LTEXT "最大角度", IDC_ANGLE_MAX_LABEL, 636, 180, 52, 16
    LTEXT "角度步进", IDC_ANGLE_STEP_LABEL, 696, 180, 52, 16
    EDITTEXT IDC_ANGLE_MIN, 576, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_MAX, 636, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_ANGLE_STEP, 696, 198, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_DIVIDER_ANGLE, "Static", SS_ETCHEDHORZ, 576, 234, 176, 2

    LTEXT "尺度范围", IDC_SCALE_TITLE, 576, 252, 176, 18
    LTEXT "模板缩放倍率，1.0 为原始尺寸", IDC_SCALE_HINT, 576, 272, 176, 16
    LTEXT "最小倍率", IDC_SCALE_MIN_LABEL, 576, 296, 52, 16
    LTEXT "最大倍率", IDC_SCALE_MAX_LABEL, 636, 296, 52, 16
    LTEXT "倍率步进", IDC_SCALE_STEP_LABEL, 696, 296, 52, 16
    EDITTEXT IDC_SCALE_MIN, 576, 314, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_MAX, 636, 314, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_SCALE_STEP, 696, 314, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_DIVIDER_SCALE, "Static", SS_ETCHEDHORZ, 576, 350, 176, 2

    LTEXT "精度与结果", IDC_RESULT_OPTIONS_TITLE, 576, 368, 176, 18
    LTEXT "亚像素：1/2/4/8 档。去重：中心半径（像素）", IDC_PRECISION_HINT, 576, 388, 176, 16
    LTEXT "金字塔层数", IDC_PYRAMID_LABEL, 576, 412, 52, 16
    LTEXT "亚像素（档）", IDC_SUBPIXEL_LABEL, 636, 412, 52, 16
    LTEXT "最低分（%）", IDC_MIN_SCORE_LABEL, 696, 412, 52, 16
    EDITTEXT IDC_PYRAMID, 576, 430, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX IDC_SUBPIXEL, 636, 430, 52, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    EDITTEXT IDC_MIN_SCORE, 696, 430, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "结果数（Top-N）", IDC_MAX_RESULTS_LABEL, 576, 462, 52, 16
    LTEXT "x 去重（px）", IDC_X_VICINITY_LABEL, 636, 462, 52, 16
    LTEXT "y 去重（px）", IDC_Y_VICINITY_LABEL, 696, 462, 52, 16
    EDITTEXT IDC_MAX_RESULTS, 576, 480, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_X_VICINITY, 636, 480, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_Y_VICINITY, 696, 480, 52, 24, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_DIVIDER_RESULT_OPTIONS, "Static", SS_ETCHEDHORZ, 576, 516, 176, 2
    LTEXT "当前为固定角度、原始尺度搜索", IDC_EXECUTION_HINT, 576, 534, 176, 16
    DEFPUSHBUTTON "执行搜索", IDC_EXECUTE, 576, 558, 176, 30, BS_OWNERDRAW | WS_TABSTOP

    LTEXT "数据目录", IDC_BATCH_DIRECTORY_TITLE, 576, 108, 176, 18
    LTEXT "目录路径（含 Thick 搜索图与模板）", IDC_BATCH_DIRECTORY_LABEL, 576, 134, 176, 16
    EDITTEXT IDC_BATCH_PATH, 576, 158, 108, 24, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择目录", IDC_BATCH_BROWSE, 692, 158, 60, 24, BS_OWNERDRAW | WS_TABSTOP
    LTEXT "执行设置", IDC_BATCH_SETTINGS_TITLE, 576, 204, 176, 18
    LTEXT "任务数为 0 时执行全部 197 对真实数据", IDC_BATCH_SETTINGS_HINT, 576, 228, 176, 16
    LTEXT "任务数（0 = 全部）", IDC_BATCH_COUNT_LABEL, 576, 254, 82, 16
    LTEXT "线程数（并行数）", IDC_BATCH_THREADS_LABEL, 670, 254, 82, 16
    EDITTEXT IDC_BATCH_COUNT, 576, 272, 82, 24, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_BATCH_THREADS, 670, 272, 82, 24, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "运行批量评估", IDC_BATCH_RUN, 576, 316, 176, 30, BS_OWNERDRAW | WS_TABSTOP
    LTEXT "统计结果", IDC_BATCH_STATS_TITLE, 576, 370, 176, 18
    CONTROL "", IDC_BATCH_STATS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_TABSTOP, 576, 394, 176, 128

    LTEXT "", IDC_STATUS_TEXT, 16, 394, 748, 20
END
